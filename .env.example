# SQLite file is created next to this path (relative to /prisma).
# Swap to Postgres later by changing the Prisma datasource provider and this URL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tradesondemand?schema=public"
DATABASE_URL="file:./dev.db"

# Public dispatch / tap-to-call number (digits, optionally with +1).
NEXT_PUBLIC_DISPATCH_PHONE="8165550136"

# Password for the lightweight /ops dispatch board.
OPS_PASSWORD="dispatch"

# PostgreSQL is required (Vercel + Neon in production).
# Neon on Vercel injects some or all of:
#   DATABASE_URL              (pooled — Prisma `url`)
#   DATABASE_URL_UNPOOLED     (direct — Prisma `directUrl` / migrate)
#   POSTGRES_PRISMA_URL
#   POSTGRES_URL_NON_POOLING
# The build script maps those aliases. If UNPOOLED is missing, it reuses DATABASE_URL.
#
# Local: use a Neon branch, Docker Postgres, or any postgres:// URL.
# Do not use file:./dev.db — the schema provider is postgresql.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/tradesondemand?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/tradesondemand?sslmode=require"

# Public dispatch / tap-to-call. Optional — the UI defaults to (816) 516-0735
# / tel:+18165160735 if neither variable is set.
NEXT_PUBLIC_DISPATCH_PHONE="8165160735"
# NEXT_PUBLIC_PHONE="8165160735"

# Password for the lightweight /ops dispatch board.
OPS_PASSWORD="dispatch"

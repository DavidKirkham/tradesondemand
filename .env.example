# =============================================================================
# PostgreSQL (required at runtime on Vercel)
# =============================================================================
# Prefer a Postgres-compatible connection string:
#   Neon, Vercel Postgres, or Supabase.
#
# Neon / Vercel Postgres may inject one of these instead of DATABASE_URL:
#   POSTGRES_PRISMA_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING,
#   DATABASE_URL_UNPOOLED
# The app and `scripts/with-db-env.cjs` map those aliases to DATABASE_URL.
#
# `prisma generate` / `next build` do NOT need a live database.
# Apply schema separately after you have a real URL:
#   npm run db:migrate
#
# Do not use file:./dev.db — schema.prisma provider is postgresql only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/tradesondemand?sslmode=require"
# Optional unpooled / direct URL (Neon). Mapped onto DATABASE_URL if the pooled URL is missing.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/tradesondemand?sslmode=require"

# =============================================================================
# Stripe (Trademark Walls sandbox — platform is merchant of record)
# =============================================================================
# Dashboard → Developers → API keys (https://dashboard.stripe.com/test/apikeys)
# Publishable key is safe on the client. App default if unset:
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51UF1qLJOVLPQ6426SHn9n0iOGiePlgrUv0gZEW5Xf41nypWfrtYrae3McmrJxIIf7bu9pw4MCkJzAdH208EqacP600nPrKp2A0"
# Server-only. Required for Checkout. Empty = bookings still work; deposit stays pending.
STRIPE_SECRET_KEY=""
# Server-only. From `stripe listen` or Dashboard → Webhooks.
STRIPE_WEBHOOK_SECRET=""
# Optional absolute origin for Checkout success/cancel URLs:
# NEXT_PUBLIC_APP_URL="https://www.tradesondemand.com"
# Optional Checkout deposit override in cents (e.g. 100 = $1.00).
# Production smoke only — remove after test. Unset restores normal deposits.
# SMOKE_DEPOSIT_CENTS is server-only (Checkout / API). BookingWizard is a client
# component, so also set NEXT_PUBLIC_SMOKE_DEPOSIT_CENTS for the $1 UI.
# Prefer SMOKE_DEPOSIT_CENTS when both are set; either alone is enough server-side.
SMOKE_DEPOSIT_CENTS="100"  # optional; Production smoke only — remove after test
NEXT_PUBLIC_SMOKE_DEPOSIT_CENTS="100"  # optional; booking UI — remove after test

# =============================================================================
# App
# =============================================================================
# Public dispatch / tap-to-call. Optional — UI defaults to (816) 516-0735
# / tel:+18165160735 if neither variable is set.
NEXT_PUBLIC_DISPATCH_PHONE="8165160735"
# NEXT_PUBLIC_PHONE="8165160735"

# /admin (and /ops → /admin). Local-dev placeholder only — pick your own value.
# Never commit a real production password. On Vercel set ADMIN_PASSWORD for
# Production and Preview (Settings → Environment Variables).
# The app reads ADMIN_PASSWORD, then OPS_PASSWORD. There is no code default.
ADMIN_PASSWORD=""
# OPS_PASSWORD=""

# Optional. Contractor Accept → text the client an ETA. Also used to text
# contractor forgot-password codes/links to the shop phone on file.
# Empty = accept still works (ETA SMS skipped). Self-serve reset will not
# deliver a text — shops use Admin → Issue set-password link instead.
# TWILIO_ACCOUNT_SID must be the Account SID (AC…), never an API Key SID (SK…).
# Prefer API Key SID + secret for Basic auth; Auth Token still works as fallback.
# TWILIO_ACCOUNT_SID=""
# TWILIO_API_KEY_SID=""
# TWILIO_API_KEY_SECRET=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

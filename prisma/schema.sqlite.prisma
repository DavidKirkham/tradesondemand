// Local-only override if you cannot run Postgres. Production uses schema.prisma (postgresql).
//   npx prisma db push --schema prisma/schema.sqlite.prisma
// Do not point Vercel at this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

model Booking {
  id              String        @id @default(cuid())
  publicId        String        @unique
  token           String        @unique
  trade           String
  problem         String
  urgency         String
  street          String
  city            String
  state           String
  zip             String
  customerName    String
  customerPhone   String
  customerEmail   String
  status          String        @default("RECEIVED")
  quoteSummary    String
  contractorId    String?
  contractor      Contractor?   @relation(fields: [contractorId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  matchPreference String        @default("FIRST_AVAILABLE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  events          StatusEvent[]
  payments        Payment[]
}

model StatusEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Contractor {
  id                 String    @id @default(cuid())
  publicId           String    @unique
  slug               String    @unique
  businessName       String
  contactName        String
  phone              String
  email              String
  tradesJson         String
  licenseNumber      String
  licenseType        String
  licenseState       String
  serviceArea        String
  insured            Boolean
  insuranceDetails   String?
  yearsExperience    Int?
  bio                String?
  hourlyRateCents    Int
  minimumChargeCents Int
  emergencyRateCents Int?
  tradeRatesJson     String
  status             String    @default("PENDING")
  reviewNote         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
}

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String
  token            String    @unique
  preferredContact String    @default("PHONE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  bookings         Booking[]
  payments         Payment[]
}

model Payment {
  id                      String    @id @default(cuid())
  publicId                String    @unique
  bookingId               String
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId              String?
  customer                Customer? @relation(fields: [customerId], references: [id])
  amountCents             Int
  type                    String
  status                  String    @default("PENDING")
  note                    String?
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([bookingId])
  @@index([customerId])
}
